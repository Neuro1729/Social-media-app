# Server
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=socialmedia
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# Redis (leave username/password empty for local Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-key-32chars-min
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# CORS (comma-separated exact origins; no wildcards with credentials)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Like synchronization
LIKE_SYNC_ENABLED=true
LIKE_SYNC_INTERVAL_MS=5000
LIKE_SYNC_BATCH_SIZE=50
