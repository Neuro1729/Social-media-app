# Leave empty to use same-origin /api.
# - Local Docker: nginx proxies /api → backend (leave empty).
# - Cloudflare Pages with functions/api proxy: leave empty so the browser stays same-origin.
# - Only set when intentionally calling a separate API origin (no trailing /api):
# VITE_API_ORIGIN=https://api.example.com
VITE_API_ORIGIN=

# Cloudflare Pages Function runtime binding (NOT a Vite variable).
# Configure in Cloudflare dashboard → Pages project → Settings → Variables and Secrets
# for both Production and Preview environments:
# BACKEND_ORIGIN=https://your-backend.example.com
